NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=
SHUTDOWN_TIMEOUT_MS=10000

DB_URL=mongodb://127.0.0.1:27017
DB_NAME=travel_app
DB_MIN_POOL_SIZE=2
DB_MAX_POOL_SIZE=10
DB_SERVER_SELECTION_TIMEOUT_MS=10000
DB_SOCKET_TIMEOUT_MS=45000

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Optional: required as a complete group only when Google OAuth is enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=Travel App
EMAIL_CONNECTION_TIMEOUT_MS=10000
EMAIL_GREETING_TIMEOUT_MS=10000
EMAIL_SOCKET_TIMEOUT_MS=20000

# Optional fallback configuration; database provider configuration remains authoritative.
HYPERPAY_BASE_URL=
HYPERPAY_ENTITY_ID=
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_WEBHOOK_SECRET=
HYPERPAY_ENVIRONMENT=test
HYPERPAY_TIMEOUT_MS=15000

STRIPE_TIMEOUT_MS=15000
STRIPE_MAX_NETWORK_RETRIES=2

PAYMENT_RECOVERY_INTERVAL_MS=120000
PAYMENT_RECOVERY_BATCH_LIMIT=50

# Optional: required only when Duffel flight search is enabled.
DUFFEL_ACCESS_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_API_VERSION=v2
DUFFEL_SUPPLIER_TIMEOUT_MS=15000
DUFFEL_HTTP_TIMEOUT_MS=20000
